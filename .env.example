# =============================================================================
# OmniMed Insight (XAI) — Central Port & Environment Configuration
# Copy this file to `.env` for local execution (`run-local.ps1` / `run-local.sh`
# will automatically create `.env` with generated local session/service secrets
# if `.env` does not exist).
# =============================================================================

# --- Mandatory Service Bind Host & Ports (Bound to localhost by default) ---
BIND_HOST=127.0.0.1
FRONTEND_PORT=3100
RUST_BACKEND_PORT=8100
PYTHON_AI_PORT=8200
FHIR_SERVER_PORT=8300
POSTGRES_PORT=5433

# --- Canonical Service URLs ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100
FRONTEND_ORIGIN=http://127.0.0.1:3100
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8200
FHIR_SERVER_URL=http://127.0.0.1:8300/fhir

# --- Database Configuration ---
# Default local SQLite database via SQLx (runs natively without requiring Docker):
DATABASE_URL=sqlite://./data/omnimed.db?mode=rwc
# Optional PostgreSQL connection string (when running PostgreSQL on port 5433 via Docker Compose):
# DATABASE_URL=postgres://omnimed_app:<CHANGE_ME_DB_PASSWORD>@127.0.0.1:5433/omnimed_insight

# --- Security & Session Configuration (Secrets omitted in .env.example) ---
# Must be at least 32 characters in `.env`:
SESSION_SECRET=<GENERATE_AT_LEAST_32_BYTE_HEX_SECRET>
INTERNAL_SERVICE_TOKEN=<GENERATE_AT_LEAST_32_BYTE_INTERNAL_TOKEN>
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# --- Initial Administrator Provisioning ---
# Used only during first-run database initialization to provision the admin account
# and synthetic clinical demonstration roles. Do not hardcode production passwords.
OMNIMED_BOOTSTRAP_ADMIN_EMAIL=admin@omnimed-insight.local
OMNIMED_BOOTSTRAP_ADMIN_PASSWORD=<SET_INITIAL_ADMIN_PASSWORD_ON_FIRST_RUN>
OMNIMED_SEED_SYNTHETIC_DEMO=true

# --- Medical AI Inference & Upload Limits ---
MAX_UPLOAD_SIZE_BYTES=15728640
STORAGE_DIR=./data/storage
AI_DEVICE_PREFERENCE=auto
# Optional path to a verified PyTorch checkpoint (.pt/.pth). When unset, the service
# runs the deterministic research-calibrated DenseNet-121 XAI pipeline and marks
# outputs as Research / Unverified Decision Support.
MODEL_WEIGHTS_PATH=
